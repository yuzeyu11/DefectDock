DEFECTDOCK_WORKSPACE=.
# Docker defaults to a lightweight API image. Set to 1 only when the image
# must include the large PyTorch/TorchVision training stack.
DEFECTDOCK_INSTALL_TRAIN=0
# Network-mode, process-wide token buckets. Local mode does not rate-limit.
# These values are both the initial burst capacity and the per-minute refill.
DEFECTDOCK_REQUESTS_PER_MINUTE=120
DEFECTDOCK_MUTATIONS_PER_MINUTE=30
DEFECTDOCK_AUTH_FAILURES_PER_MINUTE=20
CVAT_URL=http://localhost:8080
# Prefer a Personal Access Token generated in CVAT user settings.
CVAT_ACCESS_TOKEN=
# Password authentication is a local-development fallback.
CVAT_USERNAME=
CVAT_PASSWORD=
DEFECTDOCK_CVAT_CONFIG=.defectdock/cvat.json
